# ── Warren AI ──────────────────────────────────────────────────────────────
# Full URL to the Warren AI chat page (no trailing slash)
WARREN_AI_URL=https://warren.ai

# ── Browser mode ─────────────────────────────────────────────────────────────
# 'persistent' — Playwright manages its own Chromium with ./browser_profile
# 'cdp'        — Connect to Chrome with --remote-debugging-port and --remote-allow-origins='*' (111+)
WARREN_BROWSER_MODE=persistent

# CDP endpoint (only used when WARREN_BROWSER_MODE=cdp)
CHROME_CDP_URL=http://127.0.0.1:9222

# ── Browser ─────────────────────────────────────────────────────────────────
# Folder that stores your persistent login session (committed to .gitignore)
BROWSER_PROFILE_DIR=./browser_profile

# Set to true to run headless (login must already be saved in browser_profile)
HEADLESS=false

# If true, leave the browser open at end of run (useful for debugging / cdp)
KEEP_BROWSER_OPEN=false

# ── Timing ──────────────────────────────────────────────────────────────────
# How long (ms) to wait for a single AI response before giving up
MAX_WAIT_MS=180000

# How long (ms) to wait at startup for user to complete manual login
LOGIN_CHECK_TIMEOUT_MS=120000

# How often (ms) to poll response text during generation
POLL_MS=1000

# Ms of no text change required before considering a response complete
STABLE_RESPONSE_MS=8000

# ── Resume ───────────────────────────────────────────────────────────────────
# If true, skip steps whose step_0N.md already exists for today
# Use this when you need to restart after a mid-run failure
RESUME=false

# ── Validation ───────────────────────────────────────────────────────────────
# Responses shorter than this are flagged as suspicious in run_summary.json
MIN_RESPONSE_CHARS=500

# ── Paths ────────────────────────────────────────────────────────────────────
PROMPTS_DIR=./prompts
OUTPUT_DIR=./output

# ── Safety ──────────────────────────────────────────────────────────────────
# Set to true to print prompts without submitting anything
DRY_RUN=false

# ── Telegram failure alerts (optional) ───────────────────────────────────────
# Create a bot via @BotFather, then get your chat_id from @userinfobot.
# Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
