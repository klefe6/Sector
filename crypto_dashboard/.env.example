# BloFin Crypto Decision Cockpit — Phase 1
# Copy this file to .env in the project root and fill in your values.
# All private fields are OPTIONAL — the dashboard runs in public chart mode without them.

# ============================================================
# BloFin private API credentials
# Use READ ONLY keys only. Do NOT use TRADE or TRANSFER permission keys.
# Create keys at: https://blofin.com/account/apis
# ============================================================
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=

# This flag is informational only — the dashboard never places orders regardless.
BLOFIN_READ_ONLY_MODE=true

# ============================================================
# CoinGlass API (optional — derivatives / OI / funding context)
# Get your key at: https://www.coinglass.com/account/api
# ============================================================
COINGLASS_API_KEY=

# ============================================================
# Dashboard config
# ============================================================

# Port for the crypto dashboard (default 8071)
CRYPTO_PORT=8071

# ============================================================
# Telegram notifications (optional)
# Crypto sector updates and new trade ideas are sent here.
# Leave blank to disable notifications — the scanner still runs normally.
#
# Bot token: create a bot at https://t.me/BotFather
# Chat ID:   your personal chat, a group, or a channel numeric ID
# ============================================================
CRYPTO_TELEGRAM_BOT_TOKEN=
CRYPTO_TELEGRAM_CHAT_ID=

# Telegram display limits (optional — defaults shown)
# CRYPTO_TELEGRAM_MAX_SWING_TEXT=3
# CRYPTO_TELEGRAM_MAX_SCALP_LONG_TEXT=3
# CRYPTO_TELEGRAM_MAX_SCALP_SHORT_TEXT=3
# CRYPTO_TELEGRAM_MAX_SWING_CHARTS=2
# CRYPTO_TELEGRAM_MAX_SCALP_LONG_CHARTS=2
# CRYPTO_TELEGRAM_MAX_SCALP_SHORT_CHARTS=1
# CRYPTO_TELEGRAM_MAX_CHARTS_TOTAL=5
